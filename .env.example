# ReNote — Environment Configuration Template
# Copy this file to '.env' and customize values for your local or production setup.
# Never commit the actual '.env' file containing real secret keys or passwords.

# Core Django Settings
# Django secret key: Generate a secure key for production (e.g. using 'django.core.management.utils.get_random_secret_key')
SECRET_KEY=django-insecure-=6z@&gqo9j#o%dot44cv7h_!)d!0^-h56mb+tp(5aafd8s_im6

# Set DEBUG to False in production! Set to True for local development
DEBUG=True

# Comma-separated list of hostnames / domains allowed to serve the app
# In production, specify your domains (e.g. renote.app,renote.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Comma-separated list of origins trusted for CSRF in production (Django 4+)
# e.g. https://renote.app,https://renote-c16n.onrender.com
CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://127.0.0.1:8000

# Database Settings
# PostgreSQL database connection string (used by dj-database-url)
# If omitted or empty, falls back to a local SQLite database (sqlite:///db.sqlite3)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///db.sqlite3

# External APIs
# The Movie Database (TMDB) API Key (v3 auth) for movie / TV metadata search
TMDB_API_KEY=

# ==============================================================================
# Transactional Email (Password Reset & Notifications)
# ==============================================================================
# In local development (DEBUG=True), emails default to the console backend (printed in terminal).
#
# IMPORTANT FOR RENDER / CLOUD HOSTING:
# Render's Free tier BLOCKS outbound SMTP ports (25, 465, 587). Using standard SMTP on
# Render Free tier will cause requests to hang until Gunicorn aborts with a 500 timeout.
#
# RECOMMENDED FOR RENDER (HTTP API via HTTPS port 443):
# Option A: Resend (Free 3,000 emails/month — https://resend.com)
#   1. Sign up at resend.com and copy your API key (starts with 're_').
#   2. Add RESEND_API_KEY to your Render environment variables.
#   3. For quick testing without a custom domain, set DEFAULT_FROM_EMAIL=onboarding@resend.dev
#      (sends to your registered Resend account email).
#   4. For production with a custom domain, verify your domain in Resend and set DEFAULT_FROM_EMAIL.
RESEND_API_KEY=

# Option B: Brevo / Sendinblue (Free 300 emails/day — https://brevo.com)
#   Can send to any recipient without domain verification once you verify a sender address.
BREVO_API_KEY=

# Option C: SendGrid (Free 100 emails/day — https://sendgrid.com)
SENDGRID_API_KEY=

# Sender addresses displayed on outgoing emails
# When testing with unverified domain on Resend: onboarding@resend.dev
# When domain is verified: ReNote <noreply@yourdomain.com>
DEFAULT_FROM_EMAIL=ReNote <noreply@renote.app>
SERVER_EMAIL=ReNote <noreply@renote.app>

# Socket timeout in seconds (prevents hanging indefinitely if a network issue occurs)
EMAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# Standard SMTP Settings (Only works on Paid Render tiers or traditional VPS/hosts)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# For Gmail SMTP, this MUST be a 16-character Google App Password (not your normal password):
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
